rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global Safety Net — default deny all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Phase 3: Global Hardened Primitives
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'azeco77@gmail.com';
    }

    function isPasswordClinicAdmin() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'admin@novadental.eg';
    }

    function isRegisteredAdmin() {
      return (isVerifiedUser() || (isSignedIn() && request.auth.token.firebase.sign_in_provider == 'password'))
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return isPasswordClinicAdmin() || isBootstrapAdmin() || isRegisteredAdmin();
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 3
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlotId(slotId) {
      return slotId is string
        && slotId.size() >= 20
        && slotId.size() <= 48
        && slotId.matches('^(fifth-settlement|nasr-city)_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // Validation Blueprints (Synchronized verbatim with firebase-blueprint.json)
    // =========================================================================
    function isValidBranch(val) {
      return val is string && val.size() <= 32 && val in ['fifth-settlement', 'nasr-city'];
    }

    function isValidService(val) {
      return val is string && val.size() <= 40 && val in [
        'veneers-dsd',
        'immediate-implants',
        'clear-aligners',
        'laser-whitening',
        'micro-endo',
        'comprehensive-exam'
      ];
    }

    function isValidDoctor(val) {
      return val is string && val.size() <= 40 && val in ['any', 'nova-specialist'];
    }

    function isValidBookingStatus(val) {
      return val is string && val.size() <= 20 && val in [
        'pending',
        'confirmed',
        'completed',
        'cancelled',
        'no-show'
      ];
    }

    function isValidBookingSource(val) {
      return val is string && val.size() <= 20 && val in ['website', 'admin-walkin'];
    }

    function isValidBookingData(data) {
      return data.keys().hasAll([
          'referenceCode',
          'slotId',
          'branchId',
          'serviceId',
          'doctorId',
          'date',
          'time',
          'patientName',
          'patientPhone',
          'status',
          'source',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'referenceCode',
          'slotId',
          'branchId',
          'serviceId',
          'doctorId',
          'date',
          'time',
          'patientName',
          'patientPhone',
          'notes',
          'adminNotes',
          'status',
          'source',
          'createdAt',
          'updatedAt'
        ])
        && data.referenceCode is string
        && data.referenceCode.size() >= 9
        && data.referenceCode.size() <= 12
        && data.referenceCode.matches('^NV-[0-9]{6}$')
        && isValidSlotId(data.slotId)
        && isValidBranch(data.branchId)
        && isValidService(data.serviceId)
        && isValidDoctor(data.doctorId)
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string
        && data.time.size() == 5
        && data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && data.slotId == data.branchId + '_' + data.date + '_' + data.time.replace(':', '-')
        && data.patientName is string
        && data.patientName.size() >= 3
        && data.patientName.size() <= 120
        && data.patientPhone is string
        && data.patientPhone.size() >= 11
        && data.patientPhone.size() <= 15
        && data.patientPhone.matches('^01[0125][0-9]{8}$')
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && isValidBookingStatus(data.status)
        && isValidBookingSource(data.source)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookingSlotData(data, slotId) {
      return data.keys().hasAll([
          'bookingId',
          'branchId',
          'branchDate',
          'date',
          'time',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingId',
          'branchId',
          'branchDate',
          'date',
          'time',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.bookingId)
        && isValidBranch(data.branchId)
        && data.branchDate is string
        && data.branchDate.size() >= 20
        && data.branchDate.size() <= 40
        && data.branchDate == data.branchId + '_' + data.date
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string
        && data.time.size() == 5
        && data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && slotId == data.branchId + '_' + data.date + '_' + data.time.replace(':', '-')
        && data.status is string
        && data.status.size() <= 16
        && data.status in ['booked', 'released']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminData(data) {
      return data.keys().hasAll([
          'email',
          'displayName',
          'role',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'email',
          'displayName',
          'role',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.email is string
        && data.email.size() >= 5
        && data.email.size() <= 160
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 100
        && data.role is string
        && data.role.size() <= 24
        && data.role in ['super_admin', 'receptionist']
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection 1: /bookings/{bookingId} (Private Patient PII)
    // =========================================================================
    match /bookings/{bookingId} {
      // Strictly isolated PII: only verified clinic admins may read or list
      allow get: if isValidId(bookingId) && isAdmin();
      allow list: if isAdmin();

      // Public website booking OR verified admin walk-in booking with atomic slot lock
      allow create: if isValidId(bookingId)
        && isValidBookingData(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/booking_slots/$(incoming().slotId))
        && getAfter(/databases/$(database)/documents/booking_slots/$(incoming().slotId)).data.bookingId == bookingId
        && getAfter(/databases/$(database)/documents/booking_slots/$(incoming().slotId)).data.status == 'booked'
        && (
          // Public patient booking: strictly pending, website source, no adminNotes
          (
            incoming().status == 'pending'
            && incoming().source == 'website'
            && !('adminNotes' in incoming())
          )
          ||
          // Verified clinic admin creating walk-in/phone appointment
          (
            isAdmin()
            && incoming().status in ['pending', 'confirmed']
          )
        );

      // Action-based admin updates wrapped by Validation Blueprint + immutable createdAt
      allow update: if isValidId(bookingId)
        && isValidBookingData(incoming())
        && isAdmin()
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update status and/or reception adminNotes
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt'])
          ||
          // Action 2: Reschedule branch/service/doctor/date/time/slot
          incoming().diff(existing()).affectedKeys().hasOnly([
            'branchId',
            'serviceId',
            'doctorId',
            'date',
            'time',
            'slotId',
            'status',
            'adminNotes',
            'updatedAt'
          ])
          ||
          // Action 3: Edit patient contact details / notes
          incoming().diff(existing()).affectedKeys().hasOnly([
            'patientName',
            'patientPhone',
            'notes',
            'adminNotes',
            'updatedAt'
          ])
        );

      allow delete: if isValidId(bookingId) && isAdmin();
    }

    // =========================================================================
    // Collection 2: /booking_slots/{slotId} (Public Non-PII Availability Index)
    // =========================================================================
    match /booking_slots/{slotId} {
      // Public read allowed for booked slots (zero PII); admins can read all
      allow get: if isValidSlotId(slotId);
      allow list: if isAdmin() || resource.data.status == 'booked';

      // Create new slot lock atomically alongside /bookings/{bookingId}
      allow create: if isValidSlotId(slotId)
        && isValidBookingSlotData(incoming(), slotId)
        && incoming().status == 'booked'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId))
        && getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.slotId == slotId;

      // Update slot lock: admin release/reassign OR public atomic reclaim of a released slot
      allow update: if isValidSlotId(slotId)
        && isValidBookingSlotData(incoming(), slotId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'bookingId', 'updatedAt'])
        && (
          isAdmin()
          ||
          (
            existing().status == 'released'
            && incoming().status == 'booked'
            && existsAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId))
            && getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.slotId == slotId
          )
        );

      allow delete: if isValidSlotId(slotId) && isAdmin();
    }

    // =========================================================================
    // Collection 3: /admins/{adminUid} (Clinic Staff RBAC Registry)
    // =========================================================================
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(adminUid)
        && isValidAdminData(incoming())
        && isAdmin()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(adminUid)
        && isValidAdminData(incoming())
        && isAdmin()
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'active', 'updatedAt']);

      allow delete: if isValidId(adminUid) && isAdmin() && request.auth.uid != adminUid;
    }
  }
}
