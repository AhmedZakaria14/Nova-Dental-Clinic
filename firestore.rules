rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global Safety Net — default deny all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Phase 3: Global Hardened Primitives
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'azeco77@gmail.com';
    }

    function isPasswordClinicAdmin() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'admin@novadental.eg';
    }

    function isRegisteredAdmin() {
      return (isVerifiedUser() || (isSignedIn() && request.auth.token.firebase.sign_in_provider == 'password'))
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return isPasswordClinicAdmin() || isBootstrapAdmin() || isRegisteredAdmin();
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 3
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlotId(slotId) {
      return slotId is string
        && slotId.size() >= 20
        && slotId.size() <= 48
        && slotId.matches('^(fifth-settlement|nasr-city)_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // Validation Blueprints (Synchronized verbatim with firebase-blueprint.json)
    // =========================================================================
    function isValidBranch(val) {
      return val is string && val.size() <= 32 && val in ['fifth-settlement', 'nasr-city'];
    }

    function isValidInquiryBranch(val) {
      return val is string && val.size() <= 32 && val in ['fifth-settlement', 'nasr-city', 'general'];
    }

    function isValidOfferBranch(val) {
      return val is string && val.size() <= 32 && val in ['fifth-settlement', 'nasr-city', 'all'];
    }

    function isValidService(val) {
      return val is string && val.size() <= 40 && val in [
        'veneers-dsd',
        'immediate-implants',
        'clear-aligners',
        'laser-whitening',
        'micro-endo',
        'comprehensive-exam'
      ];
    }

    function isValidDoctor(val) {
      return val is string && val.size() <= 40 && val in ['any', 'nova-specialist'];
    }

    function isValidBookingStatus(val) {
      return val is string && val.size() <= 20 && val in [
        'pending',
        'confirmed',
        'completed',
        'cancelled',
        'no-show'
      ];
    }

    function isValidBookingSource(val) {
      return val is string && val.size() <= 20 && val in ['website', 'admin-walkin'];
    }

    function isValidInquiryStatus(val) {
      return val is string && val.size() <= 20 && val in [
        'new',
        'in-progress',
        'replied',
        'archived'
      ];
    }

    function isValidReviewStatus(val) {
      return val is string && val.size() <= 16 && val in [
        'pending',
        'approved',
        'rejected'
      ];
    }

    function isValidBookingData(data) {
      return data.keys().hasAll([
          'referenceCode',
          'slotId',
          'branchId',
          'serviceId',
          'doctorId',
          'date',
          'time',
          'patientName',
          'patientPhone',
          'status',
          'source',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'referenceCode',
          'slotId',
          'branchId',
          'serviceId',
          'doctorId',
          'date',
          'time',
          'patientName',
          'patientPhone',
          'notes',
          'adminNotes',
          'status',
          'source',
          'createdAt',
          'updatedAt'
        ])
        && data.referenceCode is string
        && data.referenceCode.size() >= 9
        && data.referenceCode.size() <= 12
        && data.referenceCode.matches('^NV-[0-9]{6}$')
        && isValidSlotId(data.slotId)
        && isValidBranch(data.branchId)
        && isValidService(data.serviceId)
        && isValidDoctor(data.doctorId)
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string
        && data.time.size() == 5
        && data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && data.slotId == data.branchId + '_' + data.date + '_' + data.time.replace(':', '-')
        && data.patientName is string
        && data.patientName.size() >= 3
        && data.patientName.size() <= 120
        && data.patientPhone is string
        && data.patientPhone.size() >= 11
        && data.patientPhone.size() <= 15
        && data.patientPhone.matches('^01[0125][0-9]{8}$')
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && isValidBookingStatus(data.status)
        && isValidBookingSource(data.source)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookingSlotData(data, slotId) {
      return data.keys().hasAll([
          'bookingId',
          'branchId',
          'branchDate',
          'date',
          'time',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingId',
          'branchId',
          'branchDate',
          'date',
          'time',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.bookingId)
        && isValidBranch(data.branchId)
        && data.branchDate is string
        && data.branchDate.size() >= 20
        && data.branchDate.size() <= 40
        && data.branchDate == data.branchId + '_' + data.date
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string
        && data.time.size() == 5
        && data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && slotId == data.branchId + '_' + data.date + '_' + data.time.replace(':', '-')
        && data.status is string
        && data.status.size() <= 16
        && data.status in ['booked', 'released']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminData(data) {
      return data.keys().hasAll([
          'email',
          'displayName',
          'role',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'email',
          'displayName',
          'role',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.email is string
        && data.email.size() >= 5
        && data.email.size() <= 160
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 100
        && data.role is string
        && data.role.size() <= 24
        && data.role in ['super_admin', 'receptionist']
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInquiryData(data) {
      return data.keys().hasAll([
          'referenceCode',
          'branchId',
          'name',
          'phone',
          'subject',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'referenceCode',
          'branchId',
          'name',
          'phone',
          'subject',
          'message',
          'status',
          'adminNotes',
          'createdAt',
          'updatedAt'
        ])
        && data.referenceCode is string
        && data.referenceCode.size() >= 10
        && data.referenceCode.size() <= 12
        && data.referenceCode.matches('^INQ-[0-9]{6}$')
        && isValidInquiryBranch(data.branchId)
        && data.name is string
        && data.name.size() >= 3
        && data.name.size() <= 120
        && data.phone is string
        && data.phone.size() >= 11
        && data.phone.size() <= 15
        && data.phone.matches('^01[0125][0-9]{8}$')
        && data.subject is string
        && data.subject.size() >= 2
        && data.subject.size() <= 140
        && data.message is string
        && data.message.size() >= 6
        && data.message.size() <= 1000
        && isValidInquiryStatus(data.status)
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReviewData(data) {
      return data.keys().hasAll([
          'patientName',
          'branchId',
          'treatment',
          'rating',
          'comment',
          'status',
          'featured',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'patientName',
          'branchId',
          'treatment',
          'rating',
          'comment',
          'status',
          'featured',
          'createdAt',
          'updatedAt'
        ])
        && data.patientName is string
        && data.patientName.size() >= 2
        && data.patientName.size() <= 80
        && isValidBranch(data.branchId)
        && data.treatment is string
        && data.treatment.size() >= 2
        && data.treatment.size() <= 100
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.comment is string
        && data.comment.size() >= 10
        && data.comment.size() <= 600
        && isValidReviewStatus(data.status)
        && data.featured is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOfferData(data) {
      return data.keys().hasAll([
          'titleAr',
          'titleEn',
          'badgeAr',
          'badgeEn',
          'descriptionAr',
          'descriptionEn',
          'priceLabelAr',
          'priceLabelEn',
          'serviceId',
          'branchId',
          'validUntil',
          'active',
          'featured',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'titleAr',
          'titleEn',
          'badgeAr',
          'badgeEn',
          'descriptionAr',
          'descriptionEn',
          'priceLabelAr',
          'priceLabelEn',
          'serviceId',
          'branchId',
          'validUntil',
          'active',
          'featured',
          'createdAt',
          'updatedAt'
        ])
        && data.titleAr is string
        && data.titleAr.size() >= 3
        && data.titleAr.size() <= 120
        && data.titleEn is string
        && data.titleEn.size() >= 3
        && data.titleEn.size() <= 120
        && data.badgeAr is string
        && data.badgeAr.size() >= 2
        && data.badgeAr.size() <= 40
        && data.badgeEn is string
        && data.badgeEn.size() >= 2
        && data.badgeEn.size() <= 40
        && data.descriptionAr is string
        && data.descriptionAr.size() >= 10
        && data.descriptionAr.size() <= 500
        && data.descriptionEn is string
        && data.descriptionEn.size() >= 10
        && data.descriptionEn.size() <= 500
        && data.priceLabelAr is string
        && data.priceLabelAr.size() >= 2
        && data.priceLabelAr.size() <= 80
        && data.priceLabelEn is string
        && data.priceLabelEn.size() >= 2
        && data.priceLabelEn.size() <= 80
        && isValidService(data.serviceId)
        && isValidOfferBranch(data.branchId)
        && data.validUntil is string
        && data.validUntil.size() == 10
        && data.validUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.active is bool
        && data.featured is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection 1: /bookings/{bookingId} (Private Patient PII)
    // =========================================================================
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(bookingId)
        && isValidBookingData(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/booking_slots/$(incoming().slotId))
        && getAfter(/databases/$(database)/documents/booking_slots/$(incoming().slotId)).data.bookingId == bookingId
        && getAfter(/databases/$(database)/documents/booking_slots/$(incoming().slotId)).data.status == 'booked'
        && (
          (
            incoming().status == 'pending'
            && incoming().source == 'website'
            && !('adminNotes' in incoming())
          )
          ||
          (
            isAdmin()
            && incoming().status in ['pending', 'confirmed']
          )
        );

      allow update: if isValidId(bookingId)
        && isValidBookingData(incoming())
        && isAdmin()
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt'])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'branchId',
            'serviceId',
            'doctorId',
            'date',
            'time',
            'slotId',
            'status',
            'adminNotes',
            'updatedAt'
          ])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'patientName',
            'patientPhone',
            'notes',
            'adminNotes',
            'updatedAt'
          ])
        );

      allow delete: if isValidId(bookingId) && isAdmin();
    }

    // =========================================================================
    // Collection 2: /booking_slots/{slotId} (Public Non-PII Availability Index)
    // =========================================================================
    match /booking_slots/{slotId} {
      allow get: if isValidSlotId(slotId);
      allow list: if isAdmin() || resource.data.status == 'booked';

      allow create: if isValidSlotId(slotId)
        && isValidBookingSlotData(incoming(), slotId)
        && incoming().status == 'booked'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId))
        && getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.slotId == slotId;

      allow update: if isValidSlotId(slotId)
        && isValidBookingSlotData(incoming(), slotId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'bookingId', 'updatedAt'])
        && (
          isAdmin()
          ||
          (
            existing().status == 'released'
            && incoming().status == 'booked'
            && existsAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId))
            && getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.slotId == slotId
          )
        );

      allow delete: if isValidSlotId(slotId) && isAdmin();
    }

    // =========================================================================
    // Collection 3: /admins/{adminUid} (Clinic Staff RBAC Registry)
    // =========================================================================
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(adminUid)
        && isValidAdminData(incoming())
        && isAdmin()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(adminUid)
        && isValidAdminData(incoming())
        && isAdmin()
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'active', 'updatedAt']);

      allow delete: if isValidId(adminUid) && isAdmin() && request.auth.uid != adminUid;
    }

    // =========================================================================
    // Collection 4: /inquiries/{inquiryId} (Private Contact Form Messages - PII)
    // =========================================================================
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(inquiryId)
        && isValidInquiryData(incoming())
        && incoming().status == 'new'
        && !('adminNotes' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(inquiryId)
        && isValidInquiryData(incoming())
        && isAdmin()
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt']);

      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    // =========================================================================
    // Collection 5: /reviews/{reviewId} (Moderated Patient Testimonials)
    // =========================================================================
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (resource.data.status == 'approved' || isAdmin());
      allow list: if isAdmin() || resource.data.status == 'approved';

      allow create: if isValidId(reviewId)
        && isValidReviewData(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().status == 'pending' && incoming().featured == false)
          || isAdmin()
        );

      allow update: if isValidId(reviewId)
        && isValidReviewData(incoming())
        && isAdmin()
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'featured', 'updatedAt']);

      allow delete: if isValidId(reviewId) && isAdmin();
    }

    // =========================================================================
    // Collection 6: /offers/{offerId} (Dynamic Clinic Offers & Packages)
    // =========================================================================
    match /offers/{offerId} {
      // Public can read/list ONLY active offers; admins can read/list all
      allow get: if isValidId(offerId) && (resource.data.active == true || isAdmin());
      allow list: if isAdmin() || resource.data.active == true;

      // Only verified clinic admins may create, update, or delete offers
      allow create: if isValidId(offerId)
        && isValidOfferData(incoming())
        && isAdmin()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(offerId)
        && isValidOfferData(incoming())
        && isAdmin()
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'titleAr',
          'titleEn',
          'badgeAr',
          'badgeEn',
          'descriptionAr',
          'descriptionEn',
          'priceLabelAr',
          'priceLabelEn',
          'serviceId',
          'branchId',
          'validUntil',
          'active',
          'featured',
          'updatedAt'
        ]);

      allow delete: if isValidId(offerId) && isAdmin();
    }
  }
}
